# ==============================================================================
# ISP BILLING SYSTEM - ENVIRONMENT VARIABLES
# ==============================================================================

# Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# In cPanel (e.g. Putul Host), both the database username and database name are
# prefixed with your cPanel username (e.g., if cpanel user is "nipuntop":
# username: nipuntop_ispuser, dbname: nipuntop_ispbilling)
#
# Format: postgresql://<CPANEL_USER>_<DB_USER>:<PASSWORD>@localhost:5432/<CPANEL_USER>_<DB_NAME>?schema=public
DATABASE_URL="postgresql://cpaneluser_ispuser:YourStrongPassword@localhost:5432/cpaneluser_ispbilling?schema=public"

# Authentication Security (NextAuth / JWT)
# ------------------------------------------------------------------------------
# Must be a secure random 32+ character string.
# On Linux/cPanel terminal, you can generate one using: openssl rand -base64 32
AUTH_SECRET="your-32-char-random-secret-key-here-for-production"

# Application Environment & Server Settings
# ------------------------------------------------------------------------------
NODE_ENV="production"

# Note for cPanel Phusion Passenger:
# Passenger dynamically injects the PORT or socket path into process.env.PORT.
# Our root server.js automatically reads process.env.PORT.
