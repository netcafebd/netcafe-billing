generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum BillStatus {
  UNPAID
  PAYMENT_SUBMITTED
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  BKASH
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer     Customer?
  auditLogs    AuditLog[]

  @@map("users")
}

model Customer {
  id             String         @id @default(uuid())
  userId         String         @unique
  customerCode   String         @unique
  name           String
  phone          String         @unique
  email          String?
  address        String
  monthlyBill    Decimal        @db.Decimal(10, 2)
  connectionDate DateTime       @default(now())
  status         CustomerStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bills          Bill[]
  payments       Payment[]

  @@map("customers")
}

model Bill {
  id           String     @id @default(uuid())
  customerId   String
  billingMonth Int
  billingYear  Int
  amount       Decimal    @db.Decimal(10, 2)
  dueDate      DateTime
  status       BillStatus @default(UNPAID)
  paidAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([customerId, billingMonth, billingYear])
  @@map("bills")
}

model Payment {
  id              String        @id @default(uuid())
  billId          String
  customerId      String
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod @default(BKASH)
  transactionId   String        @unique
  senderPhone     String
  status          PaymentStatus @default(PENDING)
  submittedAt     DateTime      @default(now())
  verifiedAt      DateTime?
  verifiedBy      String?
  rejectionReason String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  bill            Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@index([status])
  @@map("payments")
}

model ISPSettings {
  id                  String   @id @default(uuid())
  ispName             String   @default("NETCAFE Fiber Broadband")
  supportPhone        String   @default("01700000000")
  hotline             String   @default("16234")
  bkashNumber         String   @default("01800000000")
  bkashQrCode         String?  @default("") @db.Text
  paymentInstructions String?  @default("1. Open bKash App\n2. Select 'Send Money'\n3. Enter ISP bKash Number\n4. Enter exact bill amount\n5. Complete transaction\n6. Copy Transaction ID and submit here") @db.Text
  heroTitle           String?  @default("দ্রুততম গতিতে সংযোগ, নিরবচ্ছিন্ন ডিজিটাল জীবন") @db.Text
  heroSubtitle        String?  @default("NETCAFE ফাইবার ব্রডব্যান্ড নিয়ে এলো বাফারলেস ৪K ভিডিও স্ট্রিমিং, ১০০+ এমবিপিএস BDIX স্পিড, সুপার লো-পিং গেমিং এবং সার্বক্ষণিক ২৪/৭ টেকনিক্যাল সাপোর্ট।") @db.Text
  heroNotice          String?  @default("নতুন গ্রাহকদের জন্য ফ্রি ফাইবার ইনস্টলেশন অফার!") @db.Text
  coverageArea        String?  @default("ঢাকা, সাভার, গাজীপুর, চট্টগ্রাম এবং সারা দেশজুড়ে বিস্তৃত নেটওয়ার্ক") @db.Text
  packagesJson        String?  @default("[{\"name\":\"Regular Speed\",\"speed\":\"15 Mbps\",\"price\":500,\"bdix\":\"100 Mbps\"},{\"name\":\"Gaming Turbo\",\"speed\":\"25 Mbps\",\"price\":800,\"bdix\":\"100 Mbps\"},{\"name\":\"Super Speed\",\"speed\":\"40 Mbps\",\"price\":1200,\"bdix\":\"100 Mbps\"},{\"name\":\"Corporate Pro\",\"speed\":\"60 Mbps\",\"price\":1800,\"bdix\":\"100 Mbps\"}]") @db.Text
  updatedAt           DateTime @updatedAt

  @@map("isp_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType])
  @@map("audit_logs")
}

